# Copy to config.toml (git-ignored) and fill in real accounts.
#
# Accounts are named. Pick one with --account/-a, or leave it to `default`.
# `onepassword-cli accounts` lists them without printing any secrets.

default = "my-account"

[accounts.my-account]
username = "user@example.com"
password = "master password"
secret_key = "A3-XXXXXX-XXXXXX-XXXXX-XXXXX-XXXXX-XXXXX"

# Domain shorthand (global/eu/ca/ent) or a full sign-in address such as "acme.1password.eu".
# Defaults to my.1password.com.
# domain = "eu"

# Reuse a device id across logins so 1Password does not re-register the device every time. The CLI
# prints a fresh one on first run.
# device_id = "abcdefghijklmnopqrstuvwxyz"

# When set, the CLI generates the TOTP code instead of prompting for it. Only helps on accounts
# whose second factor is an authenticator app; Duo and WebAuthn are not supported.
# totp_secret = "BASE32SECRET"

# Route this account's traffic through a debugging proxy. Disables TLS verification.
# proxy = "http://localhost:8888"

[accounts.another-account]
username = "other@example.com"
password = "master password"
secret_key = "A3-XXXXXX-XXXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
